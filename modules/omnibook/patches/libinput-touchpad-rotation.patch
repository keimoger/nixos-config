diff -ru '--exclude=.git' pristine/src/evdev-mt-touchpad.c working/src/evdev-mt-touchpad.c
--- pristine/src/evdev-mt-touchpad.c	2026-09-04 05:24:45.799296998 +0400
+++ working/src/evdev-mt-touchpad.c	2026-09-04 05:24:45.833412888 +0400
@@ -3966,6 +3966,53 @@
 		evdev_init_left_handed(device, tp_change_to_left_handed);
 }
 
+static int
+tp_rotation_config_is_available(struct libinput_device *device)
+{
+	/* This function only gets called when we support rotation */
+	return 1;
+}
+
+static enum libinput_config_status
+tp_rotation_config_set_angle(struct libinput_device *libinput_device,
+			     unsigned int degrees_cw)
+{
+	struct evdev_device *device = evdev_device(libinput_device);
+	struct tp_dispatch *tp = (struct tp_dispatch *)device->dispatch;
+
+	tp->rotation.angle = degrees_cw;
+	matrix_init_rotate(&tp->rotation.matrix, degrees_cw);
+
+	return LIBINPUT_CONFIG_STATUS_SUCCESS;
+}
+
+static unsigned int
+tp_rotation_config_get_angle(struct libinput_device *libinput_device)
+{
+	struct evdev_device *device = evdev_device(libinput_device);
+	struct tp_dispatch *tp = (struct tp_dispatch *)device->dispatch;
+
+	return tp->rotation.angle;
+}
+
+static unsigned int
+tp_rotation_config_get_default_angle(struct libinput_device *device)
+{
+	return 0;
+}
+
+static void
+tp_init_rotation(struct tp_dispatch *tp, struct evdev_device *device)
+{
+	tp->rotation.config.is_available = tp_rotation_config_is_available;
+	tp->rotation.config.set_angle = tp_rotation_config_set_angle;
+	tp->rotation.config.get_angle = tp_rotation_config_get_angle;
+	tp->rotation.config.get_default_angle =
+		tp_rotation_config_get_default_angle;
+	matrix_init_identity(&tp->rotation.matrix);
+	device->base.config.rotation = &tp->rotation.config;
+}
+
 struct evdev_dispatch *
 evdev_mt_touchpad_create(struct evdev_device *device)
 {
@@ -3989,6 +4036,7 @@
 	tp->sendevents.config.get_default_mode = tp_sendevents_get_default_mode;
 
 	tp_init_left_handed(tp, device);
+	tp_init_rotation(tp, device);
 
 	return &tp->base;
 }
diff -ru '--exclude=.git' pristine/src/evdev-mt-touchpad-edge-scroll.c working/src/evdev-mt-touchpad-edge-scroll.c
--- pristine/src/evdev-mt-touchpad-edge-scroll.c	2026-09-04 05:24:45.799296998 +0400
+++ working/src/evdev-mt-touchpad-edge-scroll.c	2026-09-04 05:26:03.886189403 +0400
@@ -73,14 +73,45 @@
 tp_touch_get_edge(const struct tp_dispatch *tp, const struct tp_touch *t)
 {
 	uint32_t edge = EDGE_NONE;
+	bool right, bottom;
 
 	if (tp->scroll.method != LIBINPUT_CONFIG_SCROLL_EDGE)
 		return EDGE_NONE;
 
-	if (t->point.x > tp->scroll.right_edge)
+	/* Edge-scroll zones are defined in raw, physical touchpad
+	 * coordinates and don't rotate on their own -- unlike pointer
+	 * motion (tp_get_touches_delta()), which the rotation patch
+	 * already handles. Without this, "right-edge scroll" would stay
+	 * pinned to the physical right edge regardless of the screen's
+	 * current orientation, making it useful only when the laptop is
+	 * held in its normal (0 degree) orientation. Remap which physical
+	 * edge plays the "logical right" (vertical scroll) and "logical
+	 * bottom" (horizontal scroll) role based on the same
+	 * tp->rotation.angle the motion path already uses, so the two
+	 * stay consistent with each other. */
+	switch (tp->rotation.angle) {
+	case 90:
+		right = t->point.y < tp->scroll.top_edge;
+		bottom = t->point.x > tp->scroll.right_edge;
+		break;
+	case 180:
+		right = t->point.x < tp->scroll.left_edge;
+		bottom = t->point.y < tp->scroll.top_edge;
+		break;
+	case 270:
+		right = t->point.y > tp->scroll.bottom_edge;
+		bottom = t->point.x < tp->scroll.left_edge;
+		break;
+	default:
+		right = t->point.x > tp->scroll.right_edge;
+		bottom = t->point.y > tp->scroll.bottom_edge;
+		break;
+	}
+
+	if (right)
 		edge |= EDGE_RIGHT;
 
-	if (t->point.y > tp->scroll.bottom_edge)
+	if (bottom && tp->scroll.want_horiz_scroll)
 		edge |= EDGE_BOTTOM;
 
 	return edge;
@@ -315,10 +346,20 @@
 	edges = evdev_device_mm_to_units(device, &mm);
 
 	tp->scroll.right_edge = edges.x;
-	if (want_horiz_scroll)
-		tp->scroll.bottom_edge = edges.y;
-	else
-		tp->scroll.bottom_edge = INT_MAX;
+	tp->scroll.bottom_edge = edges.y;
+
+	/* Mirror thresholds from the opposite corner, for the rotated
+	 * cases where "logical right"/"logical bottom" map onto the
+	 * physical left/top edges instead. Gating (previously baked into
+	 * bottom_edge via the INT_MAX sentinel above) is now applied at
+	 * the point of use in tp_touch_get_edge() instead, since which
+	 * physical edge needs gating depends on the current rotation. */
+	mm.x = 7;
+	mm.y = 7;
+	edges = evdev_device_mm_to_units(device, &mm);
+	tp->scroll.left_edge = edges.x;
+	tp->scroll.top_edge = edges.y;
+	tp->scroll.want_horiz_scroll = want_horiz_scroll;
 
 	i = 0;
 	tp_for_each_touch(tp, t) {
