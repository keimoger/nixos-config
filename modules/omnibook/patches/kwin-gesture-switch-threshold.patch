+double VirtualDesktopManager::gestureSwitchThreshold() const
+{
+    // Externalized so this can be tuned by editing kwinrc + `qdbus
+    // org.kde.KWin /KWin reconfigure` (or just logging back in) instead
+    // of needing a full KWin recompile for every value tried -- this
+    // exact constant went through 200 -> 20 -> back to a fraction-based
+    // scheme -> .25 -> .15 -> 1/17 over the course of live-tuning it
+    // against real touchpad feel, each step previously costing a full
+    // rebuild. No caching: read fresh every call (only happens once per
+    // gesture release, so cost is a non-issue) so a live `reconfigure`
+    // call picks up a new value immediately, no restart required.
+    if (!m_config) {
+        return 1.0 / 17.0;
+    }
+    return KConfigGroup(m_config, QStringLiteral("Gestures")).readEntry("SwitchDesktopThreshold", 1.0 / 17.0);
+}
