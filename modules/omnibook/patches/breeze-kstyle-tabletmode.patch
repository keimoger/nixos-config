 //______________________________________________________________
+void Style::onTabletModeChanged(bool mode)
+{
+    if (_tabletMode == mode) {
+        return;
+    }
+    _tabletMode = mode;
+
+    // force every widget using this style to re-query its metrics and repaint,
+    // since nothing else would otherwise prompt them to notice the change
+    const QWidgetList all = qApp->allWidgets();
+    for (QWidgetList::ConstIterator it = all.constBegin(), cend = all.constEnd(); it != cend; ++it) {
+        QWidget *w = *it;
+        if (w->windowType() != Qt::Desktop && !w->testAttribute(Qt::WA_SetStyle)) {
+            QEvent e(QEvent::StyleChange);
+            QCoreApplication::sendEvent(w, &e);
+            w->update();
+        }
+    }
+}
+
+//______________________________________________________________
+int Style::formFactorMetric(MetricsType type) const
+{
+    switch (type) {
+    case Menu_FrameWidth:
+        return isTabletMode() ? Metrics::Menu_FrameWidth_Tablet : Metrics::Menu_FrameWidth;
+    case MenuItem_MarginHeight:
+        return isTabletMode() ? Metrics::MenuItem_MarginHeight_Tablet : Metrics::MenuItem_MarginHeight;
+    case LineEdit_FrameWidth:
+        return isTabletMode() ? Metrics::LineEdit_FrameWidth_Tablet : Metrics::LineEdit_FrameWidth;
+    case ComboBox_FrameWidth:
+        return isTabletMode() ? Metrics::ComboBox_FrameWidth_Tablet : Metrics::ComboBox_FrameWidth;
+    case SpinBox_FrameWidth:
+        return isTabletMode() ? Metrics::SpinBox_FrameWidth_Tablet : Metrics::SpinBox_FrameWidth;
+    case CheckBox_Size:
+        return isTabletMode() ? Metrics::CheckBox_Size_Tablet : Metrics::CheckBox_Size;
+    case Button_MarginWidth:
+        return isTabletMode() ? Metrics::Button_MarginWidth_Tablet : Metrics::Button_MarginWidth;
+    case ToolButton_MarginWidth:
+        return isTabletMode() ? Metrics::ToolButton_MarginWidth_Tablet : Metrics::ToolButton_MarginWidth;
+    case Slider_GrooveThickness:
+        return isTabletMode() ? Metrics::Slider_GrooveThickness_Tablet : Metrics::Slider_GrooveThickness;
+    case Slider_ControlThickness:
+        return isTabletMode() ? Metrics::Slider_ControlThickness_Tablet : Metrics::Slider_ControlThickness;
+    case TabBar_TabMarginHeight:
+        return isTabletMode() ? Metrics::TabBar_TabMarginHeight_Tablet : Metrics::TabBar_TabMarginHeight;
+    case TabBar_TabMarginWidth:
+        return isTabletMode() ? Metrics::TabBar_TabMarginWidth_Tablet : Metrics::TabBar_TabMarginWidth;
+    default:
+        return 0;
+    }
+}
