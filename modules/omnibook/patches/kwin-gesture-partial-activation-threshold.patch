+// The commit point for any touchpad-gesture-driven toggle built on this
+// class (Overview's grid/gesture states among them) was a hardcoded 50%
+// of the gesture's full distance -- a separate, previously-unnoticed
+// constant from SwipeGesture::s_minimumDelta and
+// VirtualDesktopManager::gestureSwitchThreshold() (virtualdesktops.cpp),
+// which only ever covered desktop-switching specifically. Externalized
+// the same way, to the same [Gestures] kwinrc group, so it's tunable
+// without a rebuild -- defaults to the original 0.5 if unset.
+static double partialActivationThreshold()
+{
+    return kwinApp()->config()->group(QStringLiteral("Gestures")).readEntry("PartialActivationThreshold", 0.5);
+}
