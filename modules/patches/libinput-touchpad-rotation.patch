+static int
+tp_rotation_config_is_available(struct libinput_device *device)
+{
+	/* This function only gets called when we support rotation */
+	return 1;
+}
+
+static enum libinput_config_status
+tp_rotation_config_set_angle(struct libinput_device *libinput_device,
+			     unsigned int degrees_cw)
+{
+	struct evdev_device *device = evdev_device(libinput_device);
+	struct tp_dispatch *tp = (struct tp_dispatch *)device->dispatch;
+
+	tp->rotation.angle = degrees_cw;
+	matrix_init_rotate(&tp->rotation.matrix, degrees_cw);
+
+	return LIBINPUT_CONFIG_STATUS_SUCCESS;
+}
+
+static unsigned int
+tp_rotation_config_get_angle(struct libinput_device *libinput_device)
+{
+	struct evdev_device *device = evdev_device(libinput_device);
+	struct tp_dispatch *tp = (struct tp_dispatch *)device->dispatch;
+
+	return tp->rotation.angle;
+}
+
+static unsigned int
+tp_rotation_config_get_default_angle(struct libinput_device *device)
+{
+	return 0;
+}
+
+static void
+tp_init_rotation(struct tp_dispatch *tp, struct evdev_device *device)
+{
+	tp->rotation.config.is_available = tp_rotation_config_is_available;
+	tp->rotation.config.set_angle = tp_rotation_config_set_angle;
+	tp->rotation.config.get_angle = tp_rotation_config_get_angle;
+	tp->rotation.config.get_default_angle =
+		tp_rotation_config_get_default_angle;
+	matrix_init_identity(&tp->rotation.matrix);
+	device->base.config.rotation = &tp->rotation.config;
+}
